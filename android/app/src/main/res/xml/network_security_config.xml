<?xml version="1.0" encoding="utf-8"?>
<!-- model_viewer_plus serves GLB assets via a loopback HTTP proxy
     (http://127.0.0.1:<port>/). Android 9+ blocks cleartext by default;
     allow it only for localhost so release builds still refuse remote HTTP. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
